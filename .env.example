# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publishable_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_aqui       # SOMENTE backend, nunca no front

# Conexao direta ao banco (opcional, para aplicar migracoes via psql)
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-REF.supabase.co:5432/postgres

# ===== IA =====
LLM_API_KEY=sua_chave_do_llm
EMBEDDING_API_KEY=sua_chave_de_embeddings

# ===== Observabilidade =====
SENTRY_DSN=

# Google OAuth (para o Supabase CLI ler ao subir a auth) - defina no ambiente
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=seu_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=seu_client_secret
